{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Tracker",
  "version": "1.0.0",
  "identifier": "com.jance.tasktracker",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Work Tracker",
        "width": 1400,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 600,
        "backgroundColor": "#0f1117"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "dmg": {} },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
